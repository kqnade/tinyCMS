{
  "name": "@tinycms/admin-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir ../../dist/admin-worker",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8788 --inspector-port 9230",
    "test": "vitest run",
    "typecheck": "wrangler types --include-runtime false --check && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tinycms/application": "workspace:*",
    "@tinycms/contracts": "workspace:*",
    "@tinycms/database": "workspace:*",
    "hono": "4.13.4"
  }
}
