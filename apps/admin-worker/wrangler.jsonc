{
  "name": "tinycms-admin-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "vars": {
    "ADMIN_HOST": "localhost",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "tinycms-admin-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations/d1"
    }
  ]
}
