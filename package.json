{
  "name": "tinycms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "build": "pnpm --filter @tinycms/studio build && pnpm --recursive --filter '!@tinycms/studio' --if-present run build",
    "check": "pnpm check:format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:format": "biome format .",
    "dev": "pnpm --parallel --filter './apps/*' --if-present run dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@cloudflare/workers-types": "5.20260825.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
